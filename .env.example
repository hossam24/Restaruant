# Copy this file to .env.local and fill it in. .env.local is never committed.
# The "Web app URL" of your Google Sheet script (ends with /exec). Leave empty to use the sample menu.
VITE_SHEET_API_URL=

# Optional: the public address of the published site, so link previews (WhatsApp, Facebook) get the share picture.
# VITE_SITE_URL=https://your-site.pages.dev
